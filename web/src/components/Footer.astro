---
const links = ["Features", "Security", "Docs", "GitHub", "Licence"];
---

<footer
  class="flex h-auto flex-col gap-4 border-t border-border px-6 py-6 sm:h-[84px] sm:flex-row sm:items-center sm:justify-between sm:px-12"
>
  <div class="flex items-center gap-2">
    <span class="text-[15px] font-bold tracking-[-0.3px] text-ink-soft">Nox</span>
    <span class="font-mono text-[9px] tracking-[0.8px] text-ink-mute">
      ENCRYPTED LOCALLY
    </span>
  </div>

  <nav class="flex flex-wrap items-center gap-6.5">
    {
      links.map((label) => (
        <a
          href={`#${label.toLowerCase()}`}
          class="text-[11.5px] text-ink-faint transition-colors hover:text-ink-soft"
        >
          {label}
        </a>
      ))
    }
  </nav>

  <p class="font-mono text-[9.5px] text-ink-mute">© 2026 Nox</p>
</footer>
