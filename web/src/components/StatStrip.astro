---
const stats = [
  { value: "Local-only", label: "vault storage", caption: "NEVER LEAVES THIS DEVICE" },
  { value: "AES-256", label: "encryption at rest", caption: "ARGON2ID KEY DERIVATION" },
  { value: "Zero", label: "telemetry", caption: "NOTHING PHONES HOME" },
  { value: "3 OS", label: "desktop builds", caption: "LINUX / MACOS / WINDOWS" },
];
---

<div
  class="grid grid-cols-2 gap-y-8 border-y border-border px-6 py-8 sm:grid-cols-4 sm:px-12"
>
  {
    stats.map((stat, i) => (
      <div class="flex flex-col gap-1.5" data-reveal style={`transition-delay:${i * 60}ms`}>
        <p class="text-[30px] font-semibold tracking-[-0.8px] text-ink">{stat.value}</p>
        <p class="text-xs text-ink-soft">{stat.label}</p>
        <p class="font-mono text-[9px] tracking-[0.7px] text-ink-mute">{stat.caption}</p>
      </div>
    ))
  }
</div>
