---
import { Download, BookOpen } from "@lucide/astro";
---

<section
  id="download"
  class="flex flex-col items-center gap-6.5 border-t border-border px-6 py-28 text-center sm:px-12"
>
  <h2 class="text-[40px] font-bold tracking-[-1.8px] sm:text-[56px]" data-reveal>
    Take your passwords back.
  </h2>
  <p class="max-w-[520px] text-[15px] leading-relaxed text-ink-faint" data-reveal>
    Free, open source, and offline by design. Nothing to sign up for.
  </p>

  <div class="flex flex-col items-center gap-3 sm:flex-row" data-reveal>
    <a
      href="https://github.com"
      class="flex h-12 items-center gap-2 rounded-[9px] bg-accent px-6.5 text-[13px] font-bold text-bg transition-transform duration-200 hover:scale-105"
    >
      <Download size={15} />
      Download Nox
    </a>
    <a
      href="/docs"
      class="flex h-12 items-center gap-2 rounded-[9px] border border-border-strong px-6.5 text-[13px] font-bold text-ink-value transition-colors duration-200 hover:border-ink-soft"
    >
      <BookOpen size={15} />
      Read the docs
    </a>
  </div>

  <p class="font-mono text-[9.5px] tracking-[0.8px] text-ink-mute" data-reveal>
    LINUX &nbsp;·&nbsp; MACOS &nbsp;·&nbsp; WINDOWS &nbsp;—&nbsp; v1.0.0
  </p>
</section>
