---
import { Download } from "@lucide/astro";
import GithubMark from "./GithubMark.astro";
---

<section id="waitlist" class="flex min-h-[700px] flex-col items-center gap-[30px] bg-ink px-5 py-20 text-center text-light min-[801px]:px-14 min-[801px]:py-28">
  <div class="flex items-center gap-3 font-mono text-[10px] font-semibold tracking-[0.7px] text-[#aeb5bf]" data-motion>
    <i class="h-px w-[34px] bg-current"></i>PREVIEW ACCESS
  </div>
  <h2 class="m-0 text-[58px] leading-[0.93] font-semibold tracking-[-0.07em] min-[801px]:text-[82px]" data-motion>
    Keep your secrets<br /><em class="not-italic text-[#82878d]">close.</em>
  </h2>
  <p class="m-0 max-w-[640px] text-[17px] leading-[1.6] text-[#aeb5bf]" data-motion>
    Nox is in preview for macOS and Linux. Open source, local-first, and built
    for every device you trust.
  </p>
  <div class="flex flex-wrap items-center justify-center gap-4" data-motion>
    <a class="inline-flex h-12 items-center gap-2 rounded-3xl bg-acid px-6 text-[13px] font-semibold text-ink transition-transform hover:scale-[1.03] focus-visible:scale-[1.03]" href="https://github.com">
      Download preview <Download size={16} />
    </a>
    <a class="inline-flex h-12 items-center gap-2 rounded-3xl border border-white/25 px-6 text-[13px] font-semibold text-light transition-colors hover:border-light focus-visible:border-light" href="https://github.com">
      <GithubMark size={16} /> View source
    </a>
  </div>
</section>
