---
import { Check, Laptop, LockKeyhole, Monitor, Smartphone } from "@lucide/astro";
---

<section id="security" class="grid grid-cols-1 items-center gap-[70px] px-5 py-[72px] min-[801px]:grid-cols-2 min-[801px]:px-14 min-[801px]:py-28">
  <div data-motion>
    <div class="flex items-center gap-3 font-mono text-[10px] font-semibold tracking-[0.7px] text-muted">
      <i class="h-px w-[34px] bg-current"></i>LOCAL-FIRST BY DESIGN
    </div>
    <h2 class="mt-5 mb-7 text-[45px] leading-[0.93] font-semibold tracking-[-0.07em] min-[801px]:text-[70px]">
      Nothing to breach<br />in the <em class="not-italic text-[#82878d]">middle.</em>
    </h2>
    <p class="m-0 max-w-[500px] text-[17px] leading-[1.6] text-muted">
      Traditional password managers put every vault behind one service. Nox
      removes that dependency. Your encrypted data stays on devices you approve
      and travels only when you pair them.
    </p>
    <ul class="grid list-none gap-[13px] p-0 text-[15px] mt-8">
      <li class="flex items-center gap-2.5"><Check size={16} />No cloud vault to target</li>
      <li class="flex items-center gap-2.5"><Check size={16} />No telemetry to collect</li>
      <li class="flex items-center gap-2.5"><Check size={16} />No account required</li>
    </ul>
  </div>

  <div class="relative h-[450px] w-[143%] origin-top-left scale-[0.7] overflow-hidden min-[801px]:h-[610px] min-[801px]:w-auto min-[801px]:scale-100" data-motion>
    <div class="pointer-events-none absolute top-[34px] left-[34px] size-[540px] rounded-full border border-[#16191d22]" data-sync-orbit="outer"></div>
    <div class="pointer-events-none absolute top-[114px] left-[114px] size-[380px] rounded-full border border-[#16191d22]" data-sync-orbit="inner"></div>

    <div class="absolute inset-0" data-sync-orbit="devices">
      <div class="absolute top-[304px] left-[304px] size-0" data-orbit-angle="0">
        <div class="absolute inset-0">
          <div class="absolute -top-[55px] -left-[75px] flex h-[110px] w-[150px] flex-col items-center justify-center gap-2.5 rounded-[14px] border border-white/13 bg-ink text-light" data-local-sync-device="laptop">
            <Laptop size={26} /><small class="font-mono text-[9px] font-semibold tracking-[0.5px]">YOUR LAPTOP</small>
          </div>
        </div>
      </div>
      <div class="absolute top-[304px] left-[304px] size-0" data-orbit-angle="120">
        <div class="absolute inset-0">
          <div class="absolute -top-[55px] -left-[75px] flex h-[110px] w-[150px] flex-col items-center justify-center gap-2.5 rounded-[14px] border border-white/13 bg-ink text-light" data-local-sync-device="tablet">
            <Monitor size={26} /><small class="font-mono text-[9px] font-semibold tracking-[0.5px]">YOUR TABLET</small>
          </div>
        </div>
      </div>
      <div class="absolute top-[304px] left-[304px] size-0" data-orbit-angle="240">
        <div class="absolute inset-0">
          <div class="absolute -top-[55px] -left-[75px] flex h-[110px] w-[150px] flex-col items-center justify-center gap-2.5 rounded-[14px] border border-white/13 bg-ink text-light" data-local-sync-device="phone">
            <Smartphone size={26} /><small class="font-mono text-[9px] font-semibold tracking-[0.5px]">YOUR PHONE</small>
          </div>
        </div>
      </div>
    </div>
    <div class="absolute top-[254px] left-[244px] flex h-[72px] w-[122px] flex-col items-center justify-center gap-2.5 rounded-[36px] border border-white/13 bg-paper text-ink">
      <LockKeyhole size={17} /><small class="text-center font-mono text-[9px] font-semibold tracking-[0.5px]">ENCRYPTED<br />SYNC</small>
    </div>
    <p class="absolute top-[474px] left-[150px] font-mono text-[9px] font-semibold tracking-[0.5px] text-muted">DEVICE ↔ DEVICE / NO SERVER IN BETWEEN</p>
  </div>
</section>

<script>
  import { animate } from "motion";

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    animate('[data-sync-orbit="inner"]', { scale: [1, 1.035, 1], opacity: [0.5, 1, 0.5] }, { duration: 3.6, repeat: Infinity, easing: "ease-in-out" });
  }
</script>

<style>
  /* Orbit radius sits between the outer (270px) and inner (190px) rings. */
  [data-orbit-angle] {
    animation: device-orbit 18s linear infinite;
  }
  [data-orbit-angle] > div {
    animation: device-counter-orbit 18s linear infinite;
  }
  /* Negative delays stagger the 3 devices to evenly-spaced 120° phases of the same path. */
  [data-orbit-angle="120"],
  [data-orbit-angle="120"] > div {
    animation-delay: -6s;
  }
  [data-orbit-angle="240"],
  [data-orbit-angle="240"] > div {
    animation-delay: -12s;
  }

  @keyframes device-orbit {
    from { transform: rotate(0deg) translate(230px); }
    to { transform: rotate(360deg) translate(230px); }
  }
  @keyframes device-counter-orbit {
    from { transform: rotate(0deg); }
    to { transform: rotate(-360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-orbit-angle] {
      animation: none;
    }
    [data-orbit-angle] > div {
      animation: none;
    }
    [data-orbit-angle="0"] { transform: rotate(0deg) translate(230px); }
    [data-orbit-angle="120"] { transform: rotate(120deg) translate(230px); }
    [data-orbit-angle="240"] { transform: rotate(240deg) translate(230px); }
    [data-orbit-angle="0"] > div { transform: rotate(0deg); }
    [data-orbit-angle="120"] > div { transform: rotate(-120deg); }
    [data-orbit-angle="240"] > div { transform: rotate(-240deg); }
  }
</style>
