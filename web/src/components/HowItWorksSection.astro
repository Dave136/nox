---
const steps = [
  ["01", "Save locally", "Create your vault on a device you control. Encryption happens before anything is stored."],
  ["02", "Pair devices", "Choose exactly which devices can see your vault. There is no account in the middle."],
  ["03", "Sync directly", "Your encrypted data travels device to device, only when you tell it to."],
];
---

<section id="how" class="bg-ink px-5 py-[72px] text-light min-[801px]:px-14 min-[801px]:pt-28 min-[801px]:pb-[140px]">
  <header class="mb-12 flex flex-col items-start justify-between gap-[30px] min-[801px]:flex-row min-[801px]:items-end" data-motion>
    <div>
      <div class="flex items-center gap-3 font-mono text-[10px] font-semibold tracking-[0.7px] text-[#aeb5bf]">
        <i class="h-px w-[34px] bg-current"></i>NO CLOUD ACCOUNT REQUIRED
      </div>
      <h2 class="mt-5 mb-0 text-[45px] leading-[0.93] font-semibold tracking-[-0.07em] min-[801px]:text-[64px]">
        Security you can<br /><em class="not-italic text-[#82878d]">actually understand.</em>
      </h2>
    </div>
    <p class="m-0 max-w-[500px] text-[17px] leading-[1.6] text-[#aeb5bf]">
      Nox keeps the security model understandable: save locally, pair
      intentionally, sync directly.
    </p>
  </header>

  <div class="grid grid-cols-1 border-y border-white/12 min-[801px]:grid-cols-3">
    {steps.map(([number, title, copy], index) => (
      <article class="flex min-h-60 flex-col justify-between border-r-0 border-b border-white/12 p-[34px] last:border-b-0 min-[801px]:min-h-[400px] min-[801px]:border-r min-[801px]:border-b-0" data-motion data-motion-delay={index * 0.08}>
        <b class="font-mono text-[10px] font-semibold tracking-[0.7px]">{number}</b>
        <h3 class="m-0 text-[31px] tracking-[-1px]">{title}</h3>
        <p class="m-0 max-w-[290px] text-[15px] leading-[1.6] text-[#aeb5bf]">{copy}</p>
      </article>
    ))}
  </div>
</section>
