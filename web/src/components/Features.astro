---
import { KeyRound, CreditCard, FileLock, Sparkles } from "@lucide/astro";

const features = [
  {
    icon: KeyRound,
    title: "Logins",
    description:
      "Usernames, passwords and site icons fetched automatically — stored encrypted, copied in one click.",
  },
  {
    icon: CreditCard,
    title: "Cards & identities",
    description:
      "Payment details and personal records kept ready to fill, and never sent anywhere.",
  },
  {
    icon: FileLock,
    title: "Secure notes",
    description:
      "Recovery codes and private keys, each with its own icon and colour so you find them fast.",
  },
  {
    icon: Sparkles,
    title: "Password generator",
    description:
      "Strong, unique passwords with a live strength read before you commit to one.",
  },
];
---

<section id="features" class="flex flex-col gap-14 px-6 py-24 sm:px-12">
  <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="flex flex-col gap-4.5" data-reveal>
      <div class="flex items-center gap-3">
        <span class="h-px w-8 bg-border-strong"></span>
        <span class="font-mono text-[11px] text-ink-faint">What's inside</span>
      </div>
      <h2 class="max-w-[560px] text-[44px] leading-[1.1] font-semibold tracking-[-1.4px]">
        One vault for everything worth protecting.
      </h2>
    </div>
    <p class="max-w-[420px] text-sm leading-relaxed text-ink-faint" data-reveal>
      Four item types, one encrypted store, one master key. Nothing else to
      configure.
    </p>
  </div>

  <div class="grid grid-cols-1 border-t border-border sm:grid-cols-4">
    {
      features.map(({ icon: Icon, title, description }, i) => (
        <div
          class:list={[
            "flex flex-col gap-3.5 py-7 pr-7",
            i > 0 && "sm:border-l sm:border-border sm:pl-7",
          ]}
          data-reveal
          style={`transition-delay:${i * 80}ms`}
        >
          <Icon size={18} class="text-ink-soft" />
          <h3 class="text-[15px] font-semibold text-ink">{title}</h3>
          <p class="text-[12.5px] leading-relaxed text-ink-faint">{description}</p>
        </div>
      ))
    }
  </div>
</section>
