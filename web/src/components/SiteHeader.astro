---
import { Menu } from "@lucide/astro";
import GithubMark from "./GithubMark.astro";
import MobileNavIsland from "./MobileNavIsland.astro";
import PlatformDownloadCta from "./PlatformDownloadCta.astro";
import { SOURCE_URL } from "../lib/download-links";
---

<header class="sticky top-0 z-50 flex h-20 items-center justify-between border-b border-line bg-paper/75 px-5 backdrop-blur-md transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] min-[801px]:px-14" data-site-header>
  <a class="flex items-center gap-2.5" href="#top" aria-label="Nox home">
    <span class="grid size-[30px] place-items-center rounded-lg bg-ink">
      <img class="w-5 invert" src="/nox-logo.svg" alt="" />
    </span>
    <span class="text-[22px] font-semibold tracking-[-0.7px]">nox</span>
    <span class="hidden font-mono text-[10px] font-semibold tracking-[0.7px] text-muted min-[801px]:inline">VAULT</span>
  </a>

  <nav class="hidden items-center gap-7 text-[13px] text-muted min-[801px]:flex" aria-label="Primary navigation">
    <a class="transition-colors hover:text-ink focus-visible:text-ink" href="#product">Product</a>
    <a class="transition-colors hover:text-ink focus-visible:text-ink" href="#how">How it works</a>
    <a class="transition-colors hover:text-ink focus-visible:text-ink" href="#security">Security</a>
    <a class="transition-colors hover:text-ink focus-visible:text-ink" href="#open">Open source</a>
    <a class="transition-colors hover:text-ink focus-visible:text-ink" href="/download">Download</a>
  </nav>

  <div class="flex items-center gap-3 min-[801px]:gap-7">
    <a class="hidden items-center gap-[7px] text-[13px] text-muted transition-colors hover:text-ink focus-visible:text-ink min-[801px]:flex" href={SOURCE_URL}>
      <GithubMark size={15} /> GitHub
    </a>
    <PlatformDownloadCta class="hidden md:flex" />

    <button
      class="grid size-11 shrink-0 place-items-center rounded-lg text-ink transition-colors hover:bg-panel min-[801px]:hidden"
      type="button"
      aria-label="Open menu"
      data-header-menu
    >
      <Menu size={20} aria-hidden="true" />
    </button>
  </div>
</header>

<MobileNavIsland />
