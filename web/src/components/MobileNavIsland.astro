---
import { Grid2x2, Menu, MonitorDown, Route, ShieldCheck, X } from "@lucide/astro";
import GithubMark from "./GithubMark.astro";
import PlatformDownloadCta from "./PlatformDownloadCta.astro";

const items = [
  { href: "#product", label: "Product", Icon: Grid2x2 },
  { href: "#how", label: "How it works", Icon: Route },
  { href: "#security", label: "Security", Icon: ShieldCheck },
  { href: "#open", label: "Open source", Icon: GithubMark },
  { href: "/download", label: "Download", Icon: MonitorDown },
];
---

<div
  class="pointer-events-none fixed inset-x-0 top-[18px] z-[60] flex justify-center px-5 opacity-0 transition-[opacity,transform] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] min-[801px]:hidden"
  data-island
  inert
>
  <div
    class="pointer-events-auto h-[52px] w-[224px] overflow-hidden rounded-[26px] border border-white/15 bg-[#171a1f] shadow-[0_12px_28px_#00000038]"
    data-island-shell
  >
    <div class="flex h-[52px] shrink-0 items-center justify-between px-[7px]" data-island-bar>
      <a class="flex min-w-0 items-center gap-[9px] pl-[7px]" href="#top" aria-label="Nox home">
        <span class="grid size-8 shrink-0 place-items-center rounded-lg">
          <img class="w-[22px] invert" src="/nox-logo.svg" alt="" />
        </span>
        <span class="text-[18px] leading-none font-[650] text-[#f2f3f5]" data-island-wordmark>nox</span>
      </a>

      <button
        class="relative grid size-[38px] shrink-0 place-items-center overflow-hidden rounded-full bg-[#262b32] text-[#f1f3f6] transition-colors hover:bg-[#292f37]"
        type="button"
        aria-expanded="false"
        aria-controls="island-menu"
        aria-label="Open menu"
        data-island-toggle
      >
        <Menu size={17} class="block transition-[opacity,scale,filter] duration-150 ease-[cubic-bezier(0.2,0,0,1)]" data-island-icon="open" aria-hidden="true" />
        <X size={17} class="absolute hidden transition-[opacity,scale,filter] duration-150 ease-[cubic-bezier(0.2,0,0,1)]" data-island-icon="close" aria-hidden="true" />
      </button>
    </div>

    <nav
      class="flex flex-col gap-0.5 px-3 pt-2.5 pb-2.5 opacity-0"
      id="island-menu"
      aria-label="Primary navigation"
      data-island-menu
      inert
    >
      {
        items.map(({ href, label, Icon }) => (
          <a
            class="flex h-[50px] items-center gap-3 rounded-xl px-3 text-[14px] font-[550] text-[#e8ebef] transition-colors hover:bg-white/6"
            href={href}
            data-island-link
          >
            <Icon size={17} class="shrink-0 text-[#aab2bd]" aria-hidden="true" />
            {label}
          </a>
        ))
      }
      <PlatformDownloadCta variant="light" class="mt-2" />
    </nav>
  </div>
</div>

<script>
  import { animate } from "motion";
  import { ISLAND, closeSequence, expandedWidthFor, openSequence } from "../lib/island-motion.ts";

  const island = document.querySelector<HTMLElement>("[data-island]");
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const shell = document.querySelector<HTMLElement>("[data-island-shell]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-island-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-island-menu]");
  const openIcon = document.querySelector<HTMLElement>('[data-island-icon="open"]');
  const closeIcon = document.querySelector<HTMLElement>('[data-island-icon="close"]');
  const headerMenu = document.querySelector<HTMLButtonElement>("[data-header-menu]");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");

  if (island && header && shell && toggle && menu && openIcon && closeIcon) {
    let stuck = false;
    let open = false;
    let busy = false;

    const run = async (steps: { keyframes: Record<string, string>; duration: number }[]) => {
      for (const step of steps) {
        const duration = reduced.matches ? 0 : step.duration;
        await animate(shell, step.keyframes, { duration, ease: [0.16, 1, 0.3, 1] }).finished;
      }
    };

    const setHeaderReplaced = (replaced: boolean) => {
      header.toggleAttribute("data-island-replaced", replaced);
      header.classList.toggle("max-[800px]:-translate-y-full", replaced);
      header.classList.toggle("max-[800px]:pointer-events-none", replaced);
    };

    const setIconState = (nextOpen: boolean) => {
      openIcon.classList.toggle("hidden", nextOpen);
      openIcon.classList.toggle("block", !nextOpen);
      closeIcon.classList.toggle("hidden", !nextOpen);
      closeIcon.classList.toggle("block", nextOpen);
    };

    const setIslandVisible = (visible: boolean) => {
      island.classList.toggle("opacity-0", !visible);
      island.classList.toggle("opacity-100", visible);
      island.toggleAttribute("inert", !visible);
    };

    const setOpen = async (next: boolean) => {
      if (busy || next === open) return;

      busy = true;
      open = next;
      setIslandVisible(open || stuck);
      setHeaderReplaced(open || stuck);
      toggle.setAttribute("aria-expanded", String(open));
      island.toggleAttribute("data-island-open", open);
      menu.toggleAttribute("inert", !open);
      setIconState(open);

      if (open) {
        menu.style.opacity = "1";
        const measuredMenuHeight = menu.scrollHeight;
        await run(openSequence(expandedWidthFor(window.innerWidth), measuredMenuHeight + ISLAND.compactHeight));
      } else {
        await run(closeSequence());
        menu.style.opacity = "0";
      }
      busy = false;
    };

    const setStuck = (next: boolean) => {
      if (open) return;
      stuck = next;
      setIslandVisible(stuck);
      setHeaderReplaced(stuck);
      shell.style.width = `${ISLAND.compactWidth}px`;
    };

    const selectAndClose = () => {
      void setOpen(false);
    };

    toggle.addEventListener("click", () => void setOpen(!open));
    headerMenu?.addEventListener("click", () => void setOpen(true));
    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", selectAndClose));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") void setOpen(false);
    });
    window.addEventListener("resize", () => {
      if (open) shell.style.width = `${expandedWidthFor(window.innerWidth)}px`;
    });
    document.addEventListener("scroll", () => setStuck(window.scrollY > header.offsetHeight), { passive: true });
    setStuck(window.scrollY > header.offsetHeight);
  }
</script>
