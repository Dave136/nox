---
import { Download } from "@lucide/astro";
import GithubMark from "./GithubMark.astro";
---

<section class="flex flex-col gap-11 px-6 pt-20 pb-16 sm:px-12 sm:pt-26 sm:pb-22">
  <div class="flex items-center gap-3" data-reveal>
    <span class="h-px w-8 bg-border-strong"></span>
    <span class="font-mono text-[11px] text-ink-faint">
      Nox v1.0 / local-first password vault
    </span>
  </div>

  <h1
    class="flex flex-col text-[15vw] leading-[0.98] font-bold tracking-[-2.6px] sm:text-[92px]"
    data-reveal
  >
    <span class="text-ink">Your passwords</span>
    <span class="text-ink-mute">never leave.</span>
  </h1>

  <div class="flex flex-col items-start gap-10 sm:flex-row sm:items-end" data-reveal>
    <p class="max-w-[520px] text-[15px] leading-relaxed text-ink-soft">
      Every login, card, and secure note is encrypted on your machine before
      anything is written to disk. No cloud account. No telemetry. No sync you
      didn't ask for.
    </p>

    <div class="flex items-center gap-3">
      <a
        href="#download"
        class="flex h-[46px] items-center gap-2 rounded-[9px] bg-accent px-[22px] text-[13px] font-bold text-bg transition-transform duration-200 hover:scale-105"
      >
        <Download size={15} />
        Download for Linux
      </a>
      <a
        href="https://github.com"
        class="flex h-[46px] items-center gap-2 rounded-[9px] border border-border-strong px-[22px] text-[13px] font-bold text-ink-value transition-colors duration-200 hover:border-ink-soft"
      >
        <GithubMark size={15} />
        View on GitHub
      </a>
    </div>
  </div>
</section>
