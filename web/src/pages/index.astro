---
import CapabilitiesSection from "../components/CapabilitiesSection.astro";
import HeroSection from "../components/HeroSection.astro";
import HowItWorksSection from "../components/HowItWorksSection.astro";
import LocalFirstSection from "../components/LocalFirstSection.astro";
import OpenSourceSection from "../components/OpenSourceSection.astro";
import ProductSection from "../components/ProductSection.astro";
import ProofStrip from "../components/ProofStrip.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import WaitlistSection from "../components/WaitlistSection.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Nox — Keep your secrets close."
  description="Nox is an open-source, local-first vault that syncs directly between devices you trust."
>
  <SiteHeader />
  <main id="top">
    <HeroSection />
    <ProofStrip />
    <ProductSection />
    <CapabilitiesSection />
    <HowItWorksSection />
    <LocalFirstSection />
    <OpenSourceSection />
    <WaitlistSection />
  </main>
  <SiteFooter />
</Layout>
